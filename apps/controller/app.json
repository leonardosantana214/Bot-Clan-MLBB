{
  "expo": {
    "name": "AERO",
    "slug": "aerobot-controller",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#08080A",
    "primaryColor": "#B3122B",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aeroclan.aerobot.controller"
    },
    "android": {
      "package": "com.aeroclan.aerobot.controller"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "AERO",
      "shortName": "AERO",
      "lang": "pt-BR",
      "scope": "/",
      "themeColor": "#08080A",
      "backgroundColor": "#08080A",
      "display": "standalone",
      "orientation": "portrait",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-font"
    ],
    "icon": "./assets/icon.png"
  }
}
